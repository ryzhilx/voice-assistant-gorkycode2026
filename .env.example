# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Yandex Cloud (SpeechKit, YandexGPT, embeddings)
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# Timezone and database
APP_TIMEZONE=Europe/Moscow
# DATABASE_PATH=assistant.db

# Optional access control (comma-separated Telegram user IDs; empty = allow everyone)
ALLOWED_USER_IDS=
RATE_LIMIT_PER_MINUTE=20

# SpeechKit synchronous STT limits (1 MB / 30 seconds)
MAX_VOICE_DURATION_SECONDS=30
MAX_VOICE_SIZE_BYTES=1000000
